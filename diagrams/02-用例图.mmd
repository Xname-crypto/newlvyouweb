flowchart LR
    subgraph 系统用户
        direction TB
        user((普通用户))
        admin((系统管理员))
        moderator((审核员))
    end
    
    subgraph 前台功能
        direction TB
        home[浏览首页]
        ticket_search[车票查询]
        post_browse[浏览帖子]
        post_publish[发布帖子]
        ai_chat[AI 助手]
        profile_view[查看个人信息]
        profile_edit[编辑个人信息]
    end
    
    subgraph 管理员功能
        direction TB
        user_mgr[用户管理]
        staff_mgr[员工管理]
        role_mgr[角色权限管理]
        api_mgr[API 配置]
        kb_mgr[知识库管理]
        datasource_mgr[数据源管理]
        dashboard[仪表盘]
    end
    
    subgraph 审核员功能
        direction TB
        post_audit[帖子审核]
        comment_audit[评论审核]
        report_handle[举报处理]
    end
    
    user --> 前台功能
    admin --> 管理员功能
    moderator --> 审核员功能
    
    ticket_search -.-> ticket_input[输入查询条件]
    ticket_search -.-> ticket_result[查看余票信息]
    
    post_publish -.-> content_edit[编辑内容]
    post_publish -.-> image_upload[上传图片]
    
    profile_edit -. extends .-> avatar_edit[修改头像]
    profile_edit -. extends .-> pwd_edit[修改密码]
    
    ai_chat -.-> rag_query[RAG 查询]
    ai_chat -.-> llm_response[AI 回答]
    
    user_mgr --> user_ops[添加/编辑/删除/封禁]
    staff_mgr --> staff_ops[添加/编辑/删除员工]
    role_mgr --> role_ops[添加/编辑角色/权限设置]
    api_mgr --> api_ops[提供商配置/日志查看]
    kb_mgr --> kb_ops[添加/编辑/删除知识]
    datasource_mgr --> ds_ops[添加/编辑数据源]
    dashboard --> dash_ops[数据统计/系统监控]
    
    post_audit --> audit_ops[通过/拒绝]
    comment_audit --> comment_ops[通过/拒绝]
    report_handle --> report_ops[查看/处理举报]
    
    style user fill:#4CAF50,color:#fff,stroke-width:2px
    style admin fill:#F44336,color:#fff,stroke-width:2px
    style moderator fill:#FF9800,color:#fff,stroke-width:2px
    style 前台功能 fill:#E3F2FD,stroke:#2196F3,stroke-width:2px
    style 管理员功能 fill:#FFEBEE,stroke:#F44336,stroke-width:2px
    style 审核员功能 fill:#FFF3E0,stroke:#FF9800,stroke-width:2px
