flowchart TD
    start([开始]) --> login[登录界面]
    login --> input{是否登录？}
    
    input -->|是 | main[主功能界面]
    input -->|否 | register[注册界面]
    
    register --> reg_input[输入账号密码]
    reg_input --> reg_submit[提交注册]
    reg_submit --> reg_check{注册成功？}
    
    reg_check -->|是 | login
    reg_check -->|否 | reg_input
    
    main --> feature{选择功能}
    
    feature -->|车票查询 | ticket[查询界面]
    feature -->|社区浏览 | community[社区界面]
    feature -->|AI 助手 | assistant[助手界面]
    feature -->|个人中心 | profile[个人界面]
    feature -->|退出登录 | login
    
    ticket --> search[输入查询条件]
    search --> query[查询数据库]
    query --> display1[显示结果]
    display1 --> feature
    
    community --> browse[浏览帖子]
    browse --> post_action{操作？}
    post_action -->|发布 | publish[发布帖子]
    post_action -->|评论 | comment[发表评论]
    post_action -->|返回 | feature
    
    publish --> save1[保存到数据库]
    save1 --> feature
    
    comment --> save2[保存到数据库]
    save2 --> feature
    
    assistant --> chat_input[输入问题]
    chat_input --> rag[RAG 处理]
    rag --> llm[LLM 推理]
    llm --> display2[显示回答]
    display2 --> feature
    
    profile --> view_info[查看信息]
    view_info --> edit_info{修改信息？}
    edit_info -->|是 | update[更新信息]
    edit_info -->|否 | feature
    update --> save3[保存到数据库]
    save3 --> feature
    
    style start fill:#4CAF50,color:#fff
    style login fill:#2196F3,color:#fff
    style main fill:#FF9800,color:#fff
    style feature fill:#FF9800,color:#fff
